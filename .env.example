# --- Frontend (bundled into the client by Vite; anon key is public by design) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Base URL of the Express API (server/). Local dev can leave this unset —
# vite.config.ts proxies /api to localhost:8080 — or set it explicitly:
VITE_API_URL=http://localhost:8080
# In Vercel (Production/Preview), set this to the deployed backend instead,
# e.g. VITE_API_URL=https://focus-hub-focv.onrender.com

# --- Server only (server/): never use the VITE_ prefix for secrets ---
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
GROQ_API_KEY=your-groq-api-key
# PORT=8080

# Comma-separated list of origins allowed to call this API (CORS).
# Defaults to localhost:5173/8080 + the production Vercel domain if unset.
# CORS_ORIGINS=http://localhost:5173,https://focus-hub-two.vercel.app
